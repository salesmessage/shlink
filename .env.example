# Local docker env for this service, consumed by sm-tool's micro-shortener compose service.
# Copy to .env and fill in the blanks. Nothing in the app reads this file directly.

DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=shlink
DB_USER=default
DB_PASSWORD=

PORT=8000
DEFAULT_DOMAIN=core.salesmsg.local
IS_HTTPS_ENABLED=true
# Must match the nginx location prefix: it prefixes every route and every generated short URL
BASE_PATH=/local/v2/shortener
WEB_WORKER_NUM=2
TASK_WORKER_NUM=4

# Not INITIAL_API_KEY: that one makes the openswoole master hit the database before it forks, and every
# worker then inherits the same connection and fails its first query. The start script creates it over the CLI
LOCAL_API_KEY=

REDIS_SERVERS=tcp://redis:6379

SKIP_INITIAL_GEOLITE_DOWNLOAD=true
#GEOLITE_LICENSE_KEY=

KAFKA_ENABLED=false
#KAFKA_BROKERS=
#KAFKA_TOPIC_PREFIX=
#KAFKA_VISITS_TOPIC=shortener

RABBITMQ_ENABLED=false
#RABBITMQ_HOST=
#RABBITMQ_PORT=5672
#RABBITMQ_USER=
#RABBITMQ_PASSWORD=
#RABBITMQ_VHOST=/

TIMEZONE=UTC
SHELL_VERBOSITY=1
