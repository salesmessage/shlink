# Local docker env for this service, consumed by sm-tool's micro-shortener compose service.
# Copy to .env and fill in the blanks. Nothing in the app reads this file directly.

DB_DRIVER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=shlink
DB_USER=default
DB_PASSWORD=

# RoadRunner listens here (config/roadrunner/.rr.yml); sm-tool's healthcheck expects 8000
PORT=8000
DEFAULT_DOMAIN=core.salesmsg.local
IS_HTTPS_ENABLED=true
# Must match the nginx location prefix: it prefixes every route and every generated short URL
BASE_PATH=/local/v2/shortener
# 0 lets RoadRunner pick the number of workers from the CPUs
WEB_WORKER_NUM=2
TASK_WORKER_NUM=2

# Created by the start script on boot when no API key exists yet
LOCAL_API_KEY=

REDIS_SERVERS=tcp://redis:6379

SKIP_INITIAL_GEOLITE_DOWNLOAD=true
#GEOLITE_LICENSE_KEY=

RABBITMQ_ENABLED=false
#RABBITMQ_HOST=
#RABBITMQ_PORT=5672
#RABBITMQ_USER=
#RABBITMQ_PASSWORD=
#RABBITMQ_VHOST=/

TIMEZONE=UTC
